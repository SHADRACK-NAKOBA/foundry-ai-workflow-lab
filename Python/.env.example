# Copy this file to .env (see docs/07-run-from-code.md), then paste your project endpoint below.
# Find it in the Foundry portal: your workflow > Code > .env variables > AZURE_EXISTING_AIPROJECT_ENDPOINT
PROJECT_ENDPOINT="your_project_endpoint"

# Must match the workflow name in the Foundry portal EXACTLY (case and dashes included).
WORKFLOW_NAME="ContosoPay-Customer-Support-Triage"
